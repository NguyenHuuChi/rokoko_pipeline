# copy to .env (git-ignored) and edit; plain KEY=VALUE, absolute paths
RAW_ROOT=/path/to/raw
OUT_ROOT=/path/to/synced
# folder with ffmpeg / ffprobe >= 5; empty = the ones on PATH
FFMPEG_DIR=
# one python per environment (requirements/*.txt)
PY_PIPELINE=python
PY_DETECT=python
PY_HANDSEG=python
PY_WILOR=python
# GPU prefix: empty = run here; Slurm: set JOB=<id> when calling run_arm2d.sh
# weights default to models/ (download_models.sh), WiLoR code to third_party/WiLoR
